{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5-5",
  "autoupdate": "notify",
  "lsp": true,
  "instructions": ["/Users/hoganmcdonald/.config/agents/HEX.md"],
  "permission": {
    "external_directory": {
      "/Users/hoganmcdonald/.config/agents/**": "allow",
      "/Users/hoganmcdonald/.day_plans/**": "allow"
    }
  },
  "plugin": [
    "opencode-vibeguard",
    "opencode-dynamic-context-pruning",
    "opencode-mermaid-renderer",
    "@datadog/opencode-plugin"
  ],
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"]
    }
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-5-5"
    },
    "build": {
      "model": "anthropic/claude-sonnet-5-5"
    }
  }
}
