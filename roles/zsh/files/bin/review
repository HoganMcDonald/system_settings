#!/usr/bin/env bash
#
# review - Review pull requests in dedicated worktrees (tuicr + opencode)
#
# Usage:
#   review <ref>            branch, PR number, PR URL, or Linear ticket/link
#   review HEAD             next-up PR (oldest pending review request)
#   review log              queue of PRs awaiting your review, with SLA
#   review status           active local review sessions
#   review snooze <ref>     drop a PR to the bottom of the stack until tomorrow
#   review clear [ref]      tear down review worktrees + tmux sessions
#   review start <ref>...   launch agent reviews in detached sessions (agent-first)
#   review result <ref>     show the latest agent review for a PR
#
# Sourcing this file with REVIEW_LIB_ONLY=1 loads the functions without
# running anything, which is how the test suite exercises the pure helpers.
# Shell options are set inside main() so sourcing cannot mutate the caller.

# --- Config ------------------------------------------------------------------

REVIEW_SLA_HOURS="${REVIEW_SLA_HOURS:-24}"
REVIEW_MAX_ACTIVE="${REVIEW_MAX_ACTIVE:-3}"
REVIEW_AGENT="${REVIEW_AGENT:-review}"
REVIEW_STATE_VERSION=1
REVIEW_JSON="${REVIEW_JSON:-}"
REVIEW_LOCK_DEPTH=0
REVIEW_TITLE_WIDTH="${REVIEW_TITLE_WIDTH:-52}"

# Records are separated by ASCII unit separator, not tab: tab is IFS whitespace,
# so `read` would collapse runs of tabs and shift every empty field.
REVIEW_FS=$'\037'

# Detect the date(1) flavor by probing behaviour, not vendor strings. BSD/macOS
# date uses -j/-r/-f; GNU date uses -d. A nix-shell or devbox puts GNU coreutils
# ahead of /bin, so this cannot be assumed from the platform.
if date -j -f '%Y-%m-%d %H:%M:%S' '2000-01-01 00:00:00' '+%s' > /dev/null 2>&1; then
  REVIEW_DATE_FLAVOR=bsd
elif date -d '2000-01-01 00:00:00' '+%s' > /dev/null 2>&1; then
  REVIEW_DATE_FLAVOR=gnu
else
  REVIEW_DATE_FLAVOR=unknown
fi

# --- Help --------------------------------------------------------------------

display_help() {
  cat << 'EOF'
review - Review pull requests in dedicated worktrees (tuicr + opencode)

Usage:
  review <ref>              Open a review session for a PR
  review HEAD               Open the next-up PR awaiting your review
  review log                Show the queue of PRs awaiting your review
  review status             Show active local review sessions
  review snooze <ref>       Snooze a PR until end of day
  review unsnooze <ref>     Undo a snooze (--all to clear every snooze)
  review clear [ref]        Tear down review worktrees and tmux sessions

Agent reviews:
  review start <ref>...     Launch agent reviews in detached sessions
  review start --next N     Launch the next N PRs awaiting your review
  review result <ref>       Show the latest agent review (--full for the report)
  review attach <ref>       Switch to a PR's review session
  review stop <ref>         Stop an active agent review (keeps the worktree)
  review stop --all         Stop every active or queued agent review
  review dispatch           Launch queued agent reviews up to the active limit

Refs:
  A ref is any of the following, all resolved in the current repository:
    feat/their-branch                       branch name
    1234 or #1234                           PR number
    https://github.com/o/r/pull/1234        PR URL
    HEX-1234                                Linear ticket identifier
    https://linear.app/team/issue/HEX-1234  Linear ticket link

  Linear refs resolve to the newest matching open PR.

Options:
  -a, --all                 Clear every snooze (unsnooze); include old runs (status);
                            every active review (stop)
      --stop                Stop active and cancel queued agent reviews first (clear)
  -f, --force               Remove worktrees with local changes; implies --stop
                            (clear). Re-review an already reviewed head (start)
  -n, --dry-run             Show what would be done (clear only)
      --json                Machine-readable output (start, status, result, dispatch)
      --next N              Pick the next N PRs from the queue (start)
      --max-active N        Concurrent running agent reviews (default 3)
      --parent-session ID   OpenCode session that requested the reviews (start)
      --full                Include the full report (result)
  -h, --help                Display this help message and exit

Sessions:
  Each PR is checked out detached in .worktrees/reviews/pr-<number> and gets a
  tmux session with two windows: tuicr (the review TUI) and opencode.
  Nothing is ever committed, pushed, or branched on your behalf.

  `review start` never switches your tmux client. It pins each run to the PR's
  head and base SHAs, starts the OpenCode `review` agent in the session, and
  records progress under <git-common-dir>/review-runs/<run-id>/. Runs beyond
  the active limit are queued and launched as earlier reviews finish.

SLA:
  "Next up" is the oldest PR whose review is still requested from you. Age is
  wall clock; the SLA column counts only Monday-Friday hours against a
  REVIEW_SLA_HOURS (default 24) business-hour target.

Environment:
  REVIEW_SLA_HOURS    Business-hour SLA target (default 24)
  REVIEW_MAX_ACTIVE   Concurrent running agent reviews (default 3)
  REVIEW_AGENT        OpenCode agent used for agent reviews (default review)
  REVIEW_DEBUG=1      Print the resolved repo, login, and matched PRs
  REVIEW_COLOR        always | never | auto (default auto: on for a terminal)
  REVIEW_BORDER       utf8 | ascii | auto (default auto: from the locale)
  NO_COLOR            Set to disable colour, per no-color.org

Examples:
  review HEAD
  review 1234
  review HEX-4821
  review log
  review snooze 1234
  review unsnooze 1234
  review unsnooze --all
  review clear
  review clear --stop       stop all agent reviews and tear everything down
  review start 1234 5678
  review start --next 3 --json
  review result 1234 --full
EOF
  exit 0
}

# --- Pure helpers ------------------------------------------------------------

# Classify a user-supplied ref into: head | pr | pr-url | linear | branch
classify_ref() {
  local ref="$1"

  if [ "$ref" = "HEAD" ] || [ "$ref" = "head" ]; then
    echo "head"
    return 0
  fi

  if [[ "$ref" =~ ^#?[0-9]+$ ]]; then
    echo "pr"
    return 0
  fi

  if [[ "$ref" =~ ^https?://[^/]*github\.com/[^/]+/[^/]+/pull/[0-9]+ ]]; then
    echo "pr-url"
    return 0
  fi

  if [[ "$ref" =~ ^https?://([^/]*\.)?linear\.app/ ]]; then
    echo "linear"
    return 0
  fi

  if [[ "$ref" =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]]; then
    echo "linear"
    return 0
  fi

  echo "branch"
}

# Extract an uppercase Linear ticket identifier from a ref, if present.
linear_ticket_from_ref() {
  local ref="$1"

  if [[ "$ref" =~ /issue/([A-Za-z][A-Za-z0-9]*-[0-9]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]'
    return 0
  fi

  if [[ "$ref" =~ ^([A-Za-z][A-Za-z0-9]*-[0-9]+)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]'
    return 0
  fi

  return 1
}

# Split a GitHub PR URL into "owner/repo number".
parse_pr_url() {
  local ref="$1"

  if [[ "$ref" =~ ^https?://[^/]*github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
    printf '%s/%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    return 0
  fi

  return 1
}

# Strip a leading '#' from a PR number.
normalize_pr_number() {
  local ref="$1"
  printf '%s\n' "${ref#\#}"
}

# Reduce a git remote URL to a lowercase "owner/repo" for comparison.
normalize_remote_repo() {
  local url="$1"
  url="${url%/}"
  url="${url%.git}"
  case "$url" in
    *://*)
      url="${url#*://}"
      url="${url#*/}"
      ;;
    *:*) url="${url#*:}" ;;
  esac
  printf '%s\n' "$url" | tr '[:upper:]' '[:lower:]'
}

# The stable prefix for review session names: the originating session's
# repository segment, so launching from a review session never nests names.
session_base_name() {
  local current="$1" repo_root="$2"

  if [ -n "$current" ]; then
    printf '%s\n' "${current%%/*}"
  else
    basename "$repo_root"
  fi
}

# Run statuses that still hold, or are about to hold, a review session.
run_is_active() {
  case "$1" in
    queued | starting | running | waiting | idle) return 0 ;;
    *) return 1 ;;
  esac
}

# jq program deriving a run's effective status from its manifest ($m), the
# agent-written status ($s), the submitted result ($r), and liveness checks.
# A live tmux session is not proof of progress, and a missing one is not
# proof of failure once a result exists, so the order below matters.
run_status_jq() {
  cat << 'JQ'
($m.state // "launched") as $state
| (if $state == "queued" then "queued"
   elif $state == "stopped" then "stopped"
   elif $r != null then "completed"
   elif ($s.status // "") == "failed" then "failed"
   elif ($live | not) then "interrupted"
   elif $pid_alive == false then "interrupted"
   else ($s.status // "starting") end) as $status
| $m + {
    status: $status,
    run_dir: $dir,
    opencode_session_id: ($s.opencode_session_id // null),
    status_detail: ($s.detail // null),
    status_updated_at: ($s.updated_at // null),
    result: (if $r == null then null else {
      verdict: $r.verdict,
      summary: $r.summary,
      counts: ($r.counts // {}),
      head_sha_reviewed: ($r.head_sha_reviewed // $m.head_sha),
      submitted_at: $r.submitted_at,
      feedback_captured: ($r.feedback_captured // [])
    } end),
    report: (if $r == null then null else ($dir + "/report.md") end)
  }
JQ
}

# Apply run_status_jq to raw JSON strings; liveness flags are true/false/null.
run_status_from() {
  local manifest="$1" status="$2" result="$3" live="$4" pid_alive="$5" dir="$6"
  jq -cn \
    --argjson m "$manifest" \
    --argjson s "$status" \
    --argjson r "$result" \
    --argjson live "$live" \
    --argjson pid_alive "$pid_alive" \
    --arg dir "$dir" \
    "$(run_status_jq)"
}

# The prompt typed into the review agent for a run.
run_prompt() {
  local url="$1" run_id="$2" head_sha="$3" base_sha="$4"
  printf 'Review %s in this dedicated review worktree. This is review run %s, pinned to head %s (base %s). Follow the pr-review skill end to end, then call review_submit with the final report.' \
    "$url" "$run_id" "$head_sha" "$base_sha"
}

# Format an epoch in local time using a strftime format (no leading '+').
epoch_format() {
  local epoch="$1" fmt="$2"

  case "$REVIEW_DATE_FLAVOR" in
    gnu) date -d "@$epoch" "+$fmt" ;;
    bsd) date -r "$epoch" "+$fmt" ;;
    *)
      echo "Error: unsupported date(1); need BSD or GNU date" >&2
      return 1
      ;;
  esac
}

# Parse "YYYY-MM-DD HH:MM:SS" in local time into an epoch.
localtime_to_epoch() {
  local stamp="$1"

  case "$REVIEW_DATE_FLAVOR" in
    gnu) date -d "$stamp" '+%s' ;;
    bsd) date -j -f '%Y-%m-%d %H:%M:%S' "$stamp" '+%s' ;;
    *)
      echo "Error: unsupported date(1); need BSD or GNU date" >&2
      return 1
      ;;
  esac
}

# Local midnight (as an epoch) for the day containing the given epoch.
local_midnight() {
  local epoch="$1"
  local day
  day=$(epoch_format "$epoch" '%Y-%m-%d')
  localtime_to_epoch "$day 00:00:00"
}

# Day of week (1=Monday .. 7=Sunday) for the given epoch.
epoch_weekday() {
  epoch_format "$1" '%u'
}

# End of the local day (next midnight) for the given epoch.
end_of_day_epoch() {
  local epoch="$1"
  local midnight next
  midnight=$(local_midnight "$epoch")
  # Advance past the day boundary with slack so DST transitions stay correct.
  next=$(local_midnight $((midnight + 90000)))
  printf '%s\n' "$next"
}

# Elapsed seconds between two epochs, counting Monday-Friday only.
business_seconds() {
  local start="$1" end="$2"

  if [ "$end" -le "$start" ]; then
    echo 0
    return 0
  fi

  local total=0 cursor="$start" day_start day_end seg_end dow
  while [ "$cursor" -lt "$end" ]; do
    day_start=$(local_midnight "$cursor")
    day_end=$(local_midnight $((day_start + 90000)))

    seg_end="$day_end"
    if [ "$seg_end" -gt "$end" ]; then
      seg_end="$end"
    fi

    dow=$(epoch_weekday "$day_start")
    if [ "$dow" -le 5 ]; then
      total=$((total + seg_end - cursor))
    fi

    cursor="$seg_end"
  done

  printf '%s\n' "$total"
}

# Format a duration in seconds as a compact human string.
format_duration() {
  local secs="$1"

  if [ "$secs" -lt 0 ]; then
    secs=$((-secs))
  fi

  local d=$((secs / 86400))
  local h=$(((secs % 86400) / 3600))
  local m=$(((secs % 3600) / 60))

  if [ "$d" -gt 0 ]; then
    printf '%dd %dh\n' "$d" "$h"
  elif [ "$h" -gt 0 ]; then
    printf '%dh %dm\n' "$h" "$m"
  else
    printf '%dm\n' "$m"
  fi
}

# Render the SLA column for a given business-hour age.
sla_cell() {
  local business="$1" sla_seconds="$2"
  local remaining=$((sla_seconds - business))

  if [ "$remaining" -lt 0 ]; then
    printf 'OVER by %s\n' "$(format_duration "$remaining")"
  else
    printf '%s left\n' "$(format_duration "$remaining")"
  fi
}

# --- Presentation ------------------------------------------------------------

# Border glyphs. Box drawing needs a UTF-8 locale, so fall back to ASCII when
# the locale does not advertise it. REVIEW_BORDER=utf8|ascii forces a style.
setup_borders() {
  local mode="${REVIEW_BORDER:-auto}"

  if [ "$mode" = auto ]; then
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
      *UTF-8* | *utf-8* | *UTF8* | *utf8*) mode=utf8 ;;
      *) mode=ascii ;;
    esac
  fi

  if [ "$mode" = utf8 ]; then
    REVIEW_B_TL='┌' REVIEW_B_TR='┐' REVIEW_B_BL='└' REVIEW_B_BR='┘'
    REVIEW_B_H='─' REVIEW_B_V='│'
    REVIEW_B_TJ='┬' REVIEW_B_BJ='┴' REVIEW_B_LJ='├' REVIEW_B_RJ='┤' REVIEW_B_CJ='┼'
  else
    REVIEW_B_TL='+' REVIEW_B_TR='+' REVIEW_B_BL='+' REVIEW_B_BR='+'
    REVIEW_B_H='-' REVIEW_B_V='|'
    REVIEW_B_TJ='+' REVIEW_B_BJ='+' REVIEW_B_LJ='+' REVIEW_B_RJ='+' REVIEW_B_CJ='+'
  fi
}

# REVIEW_COLOR=always|never|auto (default auto: on only for a real terminal).
setup_colors() {
  local mode="${REVIEW_COLOR:-auto}"

  if [ "$mode" = auto ]; then
    if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ] || [ "${TERM:-dumb}" = dumb ]; then
      mode=never
    else
      mode=always
    fi
  fi

  if [ "$mode" = always ]; then
    REVIEW_C_RESET=$'\033[0m'
    REVIEW_C_BOLD=$'\033[1m'
    REVIEW_C_DIM=$'\033[2m'
    REVIEW_C_RED=$'\033[31m'
    REVIEW_C_YELLOW=$'\033[33m'
    REVIEW_C_GREEN=$'\033[32m'
    REVIEW_C_CYAN=$'\033[36m'
  else
    REVIEW_C_RESET='' REVIEW_C_BOLD='' REVIEW_C_DIM=''
    REVIEW_C_RED='' REVIEW_C_YELLOW='' REVIEW_C_GREEN='' REVIEW_C_CYAN=''
  fi
}

# Tag a cell with a colour name. The marker is stripped by render_table before
# widths are measured, so escape bytes can never skew column alignment.
paint() {
  printf '\001%s\002%s' "$1" "$2"
}

# Compose the FLAGS cell for a queue row. `snooze_until` is an epoch or empty;
# showing the wake time answers the obvious follow-up question.
flags_cell() {
  local draft="$1" snooze_until="$2" out=""

  if [ -n "$draft" ]; then
    out="draft"
  fi

  if [ -n "$snooze_until" ]; then
    [ -n "$out" ] && out="$out,"
    out="${out}snoozed til $(epoch_format "$snooze_until" '%H:%M')" || return 1
  fi

  printf '%s\n' "${out:--}"
}

# Colour for one cell of a queue row. Snoozed rows are dimmed wholesale: the
# user has explicitly deferred them, so a red SLA breach would be noise.
row_tone() {
  local snooze_until="$1" default="$2"

  if [ -n "$snooze_until" ]; then
    echo dim
  else
    printf '%s\n' "$default"
  fi
}

# Colour for an SLA cell: breached, close to breaching, or comfortable.
sla_color() {
  local business="$1" sla_seconds="$2"
  local remaining=$((sla_seconds - business))

  if [ "$remaining" -lt 0 ]; then
    echo red
  elif [ "$remaining" -lt 14400 ]; then
    echo yellow
  else
    echo green
  fi
}

# Keep only printable ASCII so table widths line up in every terminal. Emoji and
# other wide glyphs are counted as multiple columns by awk, which skews borders.
sanitize_cell() {
  printf '%s' "$1" \
    | LC_ALL=C tr -cd '\40-\176' \
    | LC_ALL=C tr -s ' ' \
    | sed -e 's/^ *//' -e 's/ *$//'
}

truncate_cell() {
  local s="$1" n="$2"

  if [ "${#s}" -le "$n" ]; then
    printf '%s\n' "$s"
    return 0
  fi

  if [ "$n" -le 3 ]; then
    printf '%s\n' "${s:0:$n}"
    return 0
  fi

  printf '%s...\n' "${s:0:$((n - 3))}"
}

# Render tab-separated stdin (first line = header) as a box-drawn table.
# Cells may carry a \001<colour>\002 prefix from paint(); it is removed before
# measuring and re-applied after padding so ANSI bytes never affect widths.
render_table() {
  awk -F'\t' \
    -v m1=$'\001' -v m2=$'\002' \
    -v tl="$REVIEW_B_TL" -v tr="$REVIEW_B_TR" -v bl="$REVIEW_B_BL" -v br="$REVIEW_B_BR" \
    -v hb="$REVIEW_B_H" -v vb="$REVIEW_B_V" \
    -v tj="$REVIEW_B_TJ" -v bj="$REVIEW_B_BJ" -v lj="$REVIEW_B_LJ" -v rj="$REVIEW_B_RJ" \
    -v cj="$REVIEW_B_CJ" \
    -v c_bold="$REVIEW_C_BOLD" -v c_dim="$REVIEW_C_DIM" -v c_red="$REVIEW_C_RED" \
    -v c_yellow="$REVIEW_C_YELLOW" -v c_green="$REVIEW_C_GREEN" -v c_cyan="$REVIEW_C_CYAN" \
    -v c_reset="$REVIEW_C_RESET" '
    function repeat(s, n,   out, k) { out = ""; for (k = 0; k < n; k++) out = out s; return out }
    function color_of(name) {
      if (name == "red") return c_red
      if (name == "yellow") return c_yellow
      if (name == "green") return c_green
      if (name == "cyan") return c_cyan
      if (name == "dim") return c_dim
      if (name == "bold") return c_bold
      return ""
    }
    {
      rows = NR
      if (NF > maxf) maxf = NF
      for (i = 1; i <= NF; i++) {
        text = $i
        tint = ""
        # Marker parsing via index/substr, not regex: control-character escapes
        # are not portable across awk implementations.
        if (substr(text, 1, 1) == m1) {
          p = index(text, m2)
          if (p > 1) {
            tint = substr(text, 2, p - 2)
            text = substr(text, p + 1)
          }
        }
        cell[NR, i] = text
        tone[NR, i] = tint
        if (length(text) > w[i]) w[i] = length(text)
      }
    }
    END {
      if (rows == 0) exit 0

      top = tl; mid = lj; bot = bl
      for (i = 1; i <= maxf; i++) {
        bar = repeat(hb, w[i] + 2)
        top = top bar (i < maxf ? tj : tr)
        mid = mid bar (i < maxf ? cj : rj)
        bot = bot bar (i < maxf ? bj : br)
      }

      print top
      for (r = 1; r <= rows; r++) {
        line = vb
        for (i = 1; i <= maxf; i++) {
          padded = sprintf(" %-*s ", w[i], cell[r, i])
          if (r == 1) {
            line = line c_bold padded c_reset vb
          } else {
            tint = color_of(tone[r, i])
            line = line (tint == "" ? padded : tint padded c_reset) vb
          }
        }
        print line
        if (r == 1) print mid
      }
      print bot
    }
  '
}

# Convert a GitHub ISO-8601 (UTC, Z-suffixed) timestamp to an epoch.
iso_to_epoch() {
  case "$REVIEW_DATE_FLAVOR" in
    gnu) date -u -d "$1" '+%s' ;;
    bsd) date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" '+%s' ;;
    *)
      echo "Error: unsupported date(1); need BSD or GNU date" >&2
      return 1
      ;;
  esac
}

# jq program that reduces the GraphQL payload to the pending review queue.
queue_jq_program() {
  cat << 'JQ'
[
  .data.repository
  | to_entries[]
  | .value
  | select(. != null)
  | (
      .timelineItems.nodes
      | map(select(.requestedReviewer != null and .requestedReviewer.login == $me))
      | map(.createdAt)
      | sort
      | last
    ) as $requested
  | ($requested // .createdAt) as $requested_at
  | (
      .reviews.nodes
      | map(select(.author != null and .author.login == $me and .submittedAt != null))
      | map(.submittedAt)
      | sort
      | last
    ) as $reviewed_at
  | {
      number: .number,
      title: .title,
      url: .url,
      draft: .isDraft,
      author: (if .author == null then "unknown" else .author.login end),
      additions: .additions,
      deletions: .deletions,
      changed_files: .changedFiles,
      head_ref: .headRefName,
      base_ref: .baseRefName,
      requested_at: $requested_at,
      reviewed_at: $reviewed_at,
      pending: (($reviewed_at == null) or ($reviewed_at < $requested_at))
    }
]
| map(select(.pending))
| sort_by(.requested_at)
JQ
}

# Reduce a GraphQL payload on stdin into the pending queue for a given login.
queue_transform() {
  local me="$1"
  jq --arg me "$me" "$(queue_jq_program)"
}

# --- Prereqs -----------------------------------------------------------------

require_cmd() {
  local cmd="$1" hint="$2"

  if ! command -v "$cmd" &> /dev/null; then
    echo "Error: $cmd is not installed ($hint)" >&2
    exit 1
  fi
}

require_repo() {
  if ! git rev-parse --is-inside-work-tree &> /dev/null; then
    echo "Error: not inside a git repository" >&2
    exit 1
  fi

  REPO_ROOT=$(cd "$(git rev-parse --git-common-dir)/.." && pwd -P)
  GIT_COMMON_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
  REVIEWS_DIR="$REPO_ROOT/.worktrees/reviews"
  RUNS_DIR="$GIT_COMMON_DIR/review-runs"
}

# Progress chatter goes to stderr in --json mode so stdout stays parseable.
say() {
  if [ -n "$REVIEW_JSON" ]; then
    printf '%s\n' "$*" >&2
  else
    printf '%s\n' "$*"
  fi
}

# --- State -------------------------------------------------------------------

state_path() {
  printf '%s/review-state.json\n' "$GIT_COMMON_DIR"
}

lock_path() {
  printf '%s/review-state.lock\n' "$GIT_COMMON_DIR"
}

# A re-entrant mkdir lock serialises every read-modify-write of shared state,
# because several agents may launch reviews in the same repository at once.
# Command substitutions inherit REVIEW_LOCK_DEPTH, so nested calls made while
# the lock is held never deadlock or release it early.
acquire_lock() {
  if [ "$REVIEW_LOCK_DEPTH" -gt 0 ]; then
    REVIEW_LOCK_DEPTH=$((REVIEW_LOCK_DEPTH + 1))
    return 0
  fi

  local lock holder tries=0
  lock=$(lock_path)
  until mkdir "$lock" 2> /dev/null; do
    holder=$(cat "$lock/pid" 2> /dev/null || true)
    if [ -n "$holder" ] && ! kill -0 "$holder" 2> /dev/null; then
      rm -rf "$lock"
      continue
    fi
    tries=$((tries + 1))
    # A lock without a pid file is either being created or abandoned mid-write.
    if [ -z "$holder" ] && [ "$tries" -gt 50 ]; then
      rm -rf "$lock"
      continue
    fi
    if [ "$tries" -gt 1200 ]; then
      echo "Error: timed out waiting for $lock" >&2
      return 1
    fi
    sleep 0.1
  done
  printf '%s\n' "$$" > "$lock/pid"
  REVIEW_LOCK_DEPTH=1
}

release_lock() {
  if [ "$REVIEW_LOCK_DEPTH" -gt 1 ]; then
    REVIEW_LOCK_DEPTH=$((REVIEW_LOCK_DEPTH - 1))
    return 0
  fi
  REVIEW_LOCK_DEPTH=0
  rm -rf "$(lock_path)"
}

# Read state, dropping expired snoozes so every consumer sees live data only.
state_read() {
  local file now
  file=$(state_path)
  now=$(date '+%s')

  if [ ! -f "$file" ]; then
    printf '{"version":%s,"worktrees":{},"snoozes":{}}\n' "$REVIEW_STATE_VERSION"
    return 0
  fi

  jq --argjson now "$now" --argjson version "$REVIEW_STATE_VERSION" '
    {
      version: $version,
      worktrees: (.worktrees // {}),
      snoozes: ((.snoozes // {}) | with_entries(select(.value.until > $now)))
    }
  ' "$file" 2> /dev/null || printf '{"version":%s,"worktrees":{},"snoozes":{}}\n' "$REVIEW_STATE_VERSION"
}

state_write() {
  local json="$1" file tmp
  file=$(state_path)
  tmp="$file.tmp.$$"

  printf '%s\n' "$json" > "$tmp"
  mv "$tmp" "$file"
}

state_update() {
  local filter="$1"
  shift
  local current updated status=0
  acquire_lock || return 1
  current=$(state_read)
  updated=$(printf '%s' "$current" | jq "$@" "$filter") || status=$?
  if [ "$status" -eq 0 ]; then
    state_write "$updated"
  fi
  release_lock
  return "$status"
}

state_register_worktree() {
  local pr="$1" path="$2" session="$3" repo="$4" url="$5" title="$6" author="$7"

  state_update '.worktrees[$pr] = (.worktrees[$pr] // {}) + {
      path: $path,
      session: $session,
      repo: $repo,
      url: $url,
      title: $title,
      author: $author,
      created_at: $created
    }' \
    --arg pr "$pr" \
    --arg path "$path" \
    --arg session "$session" \
    --arg repo "$repo" \
    --arg url "$url" \
    --arg title "$title" \
    --arg author "$author" \
    --arg created "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
}

state_set_run() {
  state_update 'if .worktrees[$pr] then .worktrees[$pr].run_id = $run else . end' \
    --arg pr "$1" --arg run "$2"
}

state_forget_worktree() {
  state_update 'del(.worktrees[$pr])' --arg pr "$1"
}

state_set_session() {
  local pr="$1" session="$2"
  state_update 'if .worktrees[$pr] then .worktrees[$pr].session = $session else . end' \
    --arg pr "$pr" --arg session "$session"
}

state_snooze() {
  local pr="$1" until_epoch="$2"
  state_update '.snoozes[$pr] = { until: $until }' \
    --arg pr "$pr" --argjson until "$until_epoch"
}

state_unsnooze() {
  state_update 'del(.snoozes[$pr])' --arg pr "$1"
}

state_clear_snoozes() {
  state_update '.snoozes = {}'
}

state_snoozed_until() {
  state_read | jq -r --arg pr "$1" '.snoozes[$pr].until // empty'
}

# Snoozed PR numbers, oldest expiry first. Expired entries are already pruned
# by state_read, so this only ever lists live snoozes.
state_snoozed_prs() {
  state_read | jq -r '.snoozes | to_entries | sort_by(.value.until) | .[].key'
}

# Records of: pr, path, session, repo, url, title, author
state_worktree_rows() {
  state_read | jq -r --arg fs "$REVIEW_FS" '
    .worktrees
    | to_entries
    | sort_by(.key | tonumber? // 0)
    | .[]
    | [
        .key,
        (.value.path // ""),
        (.value.session // ""),
        (.value.repo // ""),
        (.value.url // ""),
        ((.value.title // "") | gsub("[\\n\\r\\t]"; " ")),
        (.value.author // "")
      ]
    | join($fs)
  '
}

state_worktree_field() {
  state_read | jq -r --arg pr "$1" --arg field "$2" '.worktrees[$pr][$field] // empty'
}

# --- GitHub ------------------------------------------------------------------

# Run a command, surfacing its stderr on failure. Swallowing errors here would
# make an auth or network problem look identical to an empty review queue.
gh_capture() {
  local out err label status=0
  # A bare `if cmd; then` swallows the failure status, so capture it explicitly.
  label="$1 ${2:-} ${3:-}"
  err=$(mktemp)

  out=$("$@" 2> "$err") || status=$?

  if [ "$status" -eq 0 ]; then
    rm -f "$err"
    printf '%s' "$out"
    return 0
  fi

  echo "Error: '${label% }' failed (exit $status)" >&2
  sed 's/^/  /' "$err" >&2
  rm -f "$err"
  return "$status"
}

debug() {
  if [ -n "${REVIEW_DEBUG:-}" ]; then
    printf 'debug: %s\n' "$*" >&2
  fi
}

# Resolve the repo and login once, in the current shell. Doing this inside a
# command substitution would both lose the cache and hide failures, because
# errexit does not propagate out of nested function/substitution layers.
init_github() {
  require_cmd gh "brew install gh"
  require_cmd jq "brew install jq"

  if [ -z "${REVIEW_REPO:-}" ]; then
    REVIEW_REPO=$(gh_capture gh repo view --json nameWithOwner -q .nameWithOwner) || exit 1
  fi

  if [ -z "${REVIEW_ME:-}" ]; then
    REVIEW_ME=$(gh_capture gh api user -q .login) || exit 1
  fi

  debug "repo=$REVIEW_REPO login=$REVIEW_ME"
}

# Fetch the pending review queue for the current repository as JSON.
queue_fetch() {
  local numbers query fragment aliases index n

  numbers=$(gh_capture gh pr list --repo "$REVIEW_REPO" \
    --search "review-requested:@me is:open" \
    --limit 50 --json number -q '.[].number') || return 1
  debug "review-requested PRs: $(printf '%s' "$numbers" | tr '\n' ' ')"

  if [ -z "$numbers" ]; then
    echo '[]'
    return 0
  fi

  aliases=""
  index=0
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    aliases+="p${index}: pullRequest(number: ${n}) { ...prFields } "
    index=$((index + 1))
  done <<< "$numbers"

  fragment='fragment prFields on PullRequest {
    number title url isDraft additions deletions changedFiles createdAt
    headRefName baseRefName
    author { login }
    timelineItems(itemTypes: [REVIEW_REQUESTED_EVENT], last: 50) {
      nodes { ... on ReviewRequestedEvent { createdAt requestedReviewer { ... on User { login } } } }
    }
    reviews(last: 50) { nodes { state submittedAt author { login } } }
  }'

  query="$fragment
  query { repository(owner: \"${REVIEW_REPO%%/*}\", name: \"${REVIEW_REPO##*/}\") { $aliases } }"

  local payload
  payload=$(gh_capture gh api graphql -f query="$query") || return 1
  printf '%s' "$payload" | queue_transform "$REVIEW_ME"
}

# Resolve a ref to a PR number in the current repository.
resolve_pr_number() {
  local ref="$1" kind repo="$REVIEW_REPO"
  kind=$(classify_ref "$ref")

  case "$kind" in
    pr)
      normalize_pr_number "$ref"
      ;;
    pr-url)
      local parsed url_repo number
      parsed=$(parse_pr_url "$ref")
      url_repo="${parsed%% *}"
      number="${parsed##* }"
      if [ "$url_repo" != "$repo" ]; then
        echo "Error: $url_repo is not the current repository ($repo)" >&2
        return 1
      fi
      printf '%s\n' "$number"
      ;;
    branch)
      local found
      found=$(gh_capture gh pr list --repo "$repo" --head "$ref" --state open \
        --limit 1 --json number -q '.[0].number') || return 1
      if [ -z "$found" ]; then
        echo "Error: no open PR found for branch '$ref' in $repo" >&2
        return 1
      fi
      printf '%s\n' "$found"
      ;;
    linear)
      resolve_linear_pr "$ref"
      ;;
    head)
      echo "Error: HEAD cannot be resolved here" >&2
      return 1
      ;;
  esac
}

# Resolve a Linear ticket to the newest matching open PR.
resolve_linear_pr() {
  local ref="$1" ticket found repo="$REVIEW_REPO"
  if ! ticket=$(linear_ticket_from_ref "$ref"); then
    echo "Error: could not extract a Linear ticket from '$ref'" >&2
    return 1
  fi

  found=$(gh_capture gh pr list --repo "$repo" --state open --search "$ticket" \
    --limit 50 --json number,createdAt \
    -q 'sort_by(.createdAt) | .[-1].number') || return 1

  if [ -z "$found" ] || [ "$found" = "null" ]; then
    # Fall back to matching the ticket inside head branch names.
    local listing
    listing=$(gh_capture gh pr list --repo "$repo" --state open --limit 200 \
      --json number,headRefName,title,createdAt) || return 1
    found=$(printf '%s' "$listing" \
      | jq -r --arg t "$(printf '%s' "$ticket" | tr '[:upper:]' '[:lower:]')" '
          map(select(
            ((.headRefName // "") | ascii_downcase | contains($t)) or
            ((.title // "") | ascii_downcase | contains($t))
          ))
          | sort_by(.createdAt)
          | .[-1].number // empty
        ')
  fi

  if [ -z "$found" ] || [ "$found" = "null" ]; then
    echo "Error: no open PR in $repo references $ticket" >&2
    return 1
  fi

  printf '%s\n' "$found"
}

# Pick the next-up PR: oldest pending request, skipping drafts and snoozes.
resolve_head_pr() {
  local queue snoozes candidate
  queue=$(queue_fetch) || return 1

  if [ "$(printf '%s' "$queue" | jq 'length')" -eq 0 ]; then
    echo "Error: no PRs are awaiting your review" >&2
    return 1
  fi

  snoozes=$(state_read | jq '.snoozes | keys')

  candidate=$(printf '%s' "$queue" | jq -r --argjson snoozes "$snoozes" '
    map(select(.draft == false))
    | map(select((.number | tostring) as $n | ($snoozes | index($n)) == null))
    | .[0].number // empty
  ')

  if [ -z "$candidate" ]; then
    echo "Error: every pending review is snoozed or in draft" >&2
    echo "Hint: run 'review log' to see the queue." >&2
    return 1
  fi

  printf '%s\n' "$candidate"
}

# --- Worktrees and sessions --------------------------------------------------

worktree_path_for_pr() {
  printf '%s/pr-%s\n' "$REVIEWS_DIR" "$1"
}

review_ref_for_pr() {
  printf 'refs/review/pr/%s\n' "$1"
}

worktree_is_registered() {
  local path="$1"
  git worktree list --porcelain | grep -qxF "worktree $path"
}

# Append review worktrees that exist on disk but are missing from state, so
# orphans left behind by a crash are still visible and still cleanable.
append_unregistered_rows() {
  local rows="$1" title="$2"
  local dir base pr known

  if [ ! -d "$REVIEWS_DIR" ]; then
    printf '%s' "$rows"
    return 0
  fi

  known=$(printf '%s\n' "$rows" | cut -d "$REVIEW_FS" -f1)

  for dir in "$REVIEWS_DIR"/*; do
    [ -d "$dir" ] || continue
    base=$(basename "$dir")
    pr="${base#pr-}"
    case "$pr" in
      '' | *[!0-9]*) continue ;;
    esac
    if printf '%s\n' "$known" | grep -qxF "$pr"; then
      continue
    fi
    rows+=$'\n'"${pr}${REVIEW_FS}${dir}${REVIEW_FS}${REVIEW_FS}${REVIEW_FS}${REVIEW_FS}${title}${REVIEW_FS}"
  done

  printf '%s' "$rows" | grep -v '^$' || true
}

find_sessions_for_worktree() {
  local wt_path="$1"

  tmux list-panes -a -F '#{session_name}::#{pane_current_path}' 2> /dev/null \
    | while IFS= read -r line; do
      local session pane_path
      session="${line%%::*}"
      pane_path="${line##*::}"
      case "$pane_path" in
        "$wt_path" | "$wt_path"/*)
          printf '%s\n' "$session"
          ;;
      esac
    done | sort -u
}

session_exists() {
  local session="$1"
  [ -n "$session" ] && tmux has-session -t "=$session" 2> /dev/null
}

session_name_for_pr() {
  local pr="$1" current=""

  if [ -n "${TMUX:-}" ]; then
    current=$(tmux display-message -p '#S' 2> /dev/null || true)
  fi
  printf '%s/review/pr-%s\n' "$(session_base_name "$current" "$REPO_ROOT")" "$pr"
}

attach_session() {
  local session="$1"

  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}

# The remote that actually hosts the resolved GitHub repository. Assuming
# `origin` would silently review a fork's PR head in a multi-remote clone.
resolve_fetch_remote() {
  local want remote url
  want=$(printf '%s' "$REVIEW_REPO" | tr '[:upper:]' '[:lower:]')

  while IFS= read -r remote; do
    [ -n "$remote" ] || continue
    url=$(git remote get-url "$remote" 2> /dev/null) || continue
    if [ "$(normalize_remote_repo "$url")" = "$want" ]; then
      printf '%s\n' "$remote"
      return 0
    fi
  done < <(git remote)

  echo "Error: no git remote points at $REVIEW_REPO" >&2
  return 1
}

# Fetch the PR head into a private ref and print the fetched commit.
fetch_pr_ref() {
  local pr="$1" ref remote
  ref=$(review_ref_for_pr "$pr")
  remote=$(resolve_fetch_remote) || return 1

  say "Fetching PR #$pr from $remote..."
  if ! git fetch --quiet --no-tags "$remote" "+refs/pull/$pr/head:$ref" >&2; then
    echo "Error: failed to fetch refs/pull/$pr/head from $remote" >&2
    return 1
  fi
  git rev-parse "$ref"
}

# Create or refresh the PR's detached worktree at the fetched head, printing
# the checked-out commit. Returns 2 for conflicts that need a human: an
# unregistered directory in the way, or local changes that a refresh would
# clobber. Nothing is ever deleted here.
prepare_worktree() {
  local pr="$1" path="$2" sha current

  if [ -d "$path" ] && ! worktree_is_registered "$path"; then
    echo "Conflict: $path exists but is not a registered worktree; move it aside or run 'git worktree prune'" >&2
    return 2
  fi

  sha=$(fetch_pr_ref "$pr") || return 1

  if [ -d "$path" ]; then
    current=$(git -C "$path" rev-parse HEAD)
    if [ "$current" != "$sha" ]; then
      if [ -n "$(git -C "$path" status --porcelain 2> /dev/null)" ]; then
        echo "Conflict: .worktrees/reviews/pr-$pr has local changes and is at ${current:0:10}, not the PR head ${sha:0:10}" >&2
        return 2
      fi
      say "Moving .worktrees/reviews/pr-$pr to the new PR head ${sha:0:10}."
      git -C "$path" checkout --quiet --detach "$sha"
    fi
  else
    mkdir -p "$REVIEWS_DIR"
    git worktree add --quiet --detach "$path" "$sha" > /dev/null
  fi

  printf '%s\n' "$sha"
}

create_review_session() {
  local session="$1" path="$2" url="$3"

  tmux new-session -d -s "$session" -n "tuicr" -c "$path"
  tmux send-keys -t "$session:tuicr" "tuicr pr $(printf '%q' "$url")" Enter

  tmux new-window -t "$session" -n "opencode" -c "$path"
  tmux send-keys -t "$session:opencode" "opencode --agent $(printf '%q' "$REVIEW_AGENT")" Enter

  tmux select-window -t "$session:tuicr"
}

# --- Agent review runs -------------------------------------------------------
#
# A run directory holds everything about one agent review:
#   manifest.json  launch facts and lifecycle state, written by this script
#   status.json    live progress, written by the OpenCode plugin in the session
#   result.json    structured outcome, written by the review_submit tool
#   report.md      the full review report
# Results outlive worktrees, so `review clear` never deletes run directories.

run_dir_for() {
  printf '%s/%s\n' "$RUNS_DIR" "$1"
}

new_run_id() {
  printf 'pr-%s-%s-%04x\n' "$1" "$(date -u '+%Y%m%dT%H%M%SZ')" "$((RANDOM % 65536))"
}

write_file_atomic() {
  local file="$1" content="$2" tmp
  tmp="$file.tmp.$$"
  printf '%s\n' "$content" > "$tmp"
  mv "$tmp" "$file"
}

json_file_or() {
  local file="$1" fallback="$2"

  if [ -f "$file" ] && jq -e . "$file" > /dev/null 2>&1; then
    cat "$file"
  else
    printf '%s\n' "$fallback"
  fi
}

manifest_update() {
  local id="$1" filter="$2"
  shift 2
  local file updated
  file="$(run_dir_for "$id")/manifest.json"
  acquire_lock || return 1
  updated=$(jq "$@" "$filter" "$file") && write_file_atomic "$file" "$updated"
  release_lock
}

run_ids() {
  [ -d "$RUNS_DIR" ] || return 0
  local dir
  for dir in "$RUNS_DIR"/pr-*; do
    [ -f "$dir/manifest.json" ] && basename "$dir"
  done | sort
}

latest_run_for_pr() {
  run_ids | grep "^pr-$1-" | tail -1 || true
}

# Effective run record: manifest plus derived status, as one JSON object.
run_record() {
  local id="$1" dir manifest status result session pid live=false pid_alive=null
  dir=$(run_dir_for "$id")
  [ -f "$dir/manifest.json" ] || return 1

  manifest=$(json_file_or "$dir/manifest.json" '{}')
  status=$(json_file_or "$dir/status.json" '{}')
  result=$(json_file_or "$dir/result.json" 'null')

  session=$(printf '%s' "$manifest" | jq -r '.tmux_session // empty')
  if session_exists "$session"; then
    live=true
  fi

  pid=$(printf '%s' "$status" | jq -r '.pid // empty')
  if [ -n "$pid" ]; then
    if kill -0 "$pid" 2> /dev/null; then pid_alive=true; else pid_alive=false; fi
  fi

  run_status_from "$manifest" "$status" "$result" "$live" "$pid_alive" "$dir"
}

run_status() {
  run_record "$1" | jq -r '.status'
}

count_running_runs() {
  local id n=0
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    case "$(run_status "$id")" in
      starting | running) n=$((n + 1)) ;;
    esac
  done < <(run_ids)
  printf '%s\n' "$n"
}

mark_run_failed() {
  local id="$1" detail="$2" file
  file="$(run_dir_for "$id")/status.json"
  write_file_atomic "$file" "$(jq -n --arg d "$detail" --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    '{status: "failed", detail: $d, updated_at: $now}')"
}

# Launch one queued run: refresh its worktree, open (or extend) its tmux
# session, and type the review prompt into a fresh OpenCode instance.
launch_run() {
  local id="$1" manifest pr url path session sha base_sha window err status=0
  manifest=$(cat "$(run_dir_for "$id")/manifest.json")
  pr=$(printf '%s' "$manifest" | jq -r '.pr')
  url=$(printf '%s' "$manifest" | jq -r '.url')
  path=$(printf '%s' "$manifest" | jq -r '.worktree')
  session=$(printf '%s' "$manifest" | jq -r '.tmux_session')
  base_sha=$(printf '%s' "$manifest" | jq -r '.base_sha')

  err=$(mktemp)
  sha=$(prepare_worktree "$pr" "$path" 2> "$err") || status=$?
  if [ "$status" -ne 0 ]; then
    mark_run_failed "$id" "$(tr '\n' ' ' < "$err" | sed 's/ *$//')"
    cat "$err" >&2
    rm -f "$err"
    manifest_update "$id" '.state = "launched" | .launched_at = $now' --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    return 1
  fi
  rm -f "$err"

  local env_args=(
    -e "REVIEW_RUN_ID=$id"
    -e "REVIEW_RUN_DIR=$(run_dir_for "$id")"
    -e "REVIEW_PR_URL=$url"
    -e "REVIEW_HEAD_SHA=$sha"
  )
  local prompt agent_cmd
  prompt=$(run_prompt "$url" "$id" "$sha" "$base_sha")
  agent_cmd="opencode --agent $(printf '%q' "$REVIEW_AGENT") --prompt $(printf '%q' "$prompt")"

  if session_exists "$session"; then
    # An interactive session already exists for this PR: add the agent beside it.
    window="review-agent"
    tmux new-window -d -t "$session" -n "$window" -c "$path" "${env_args[@]}"
  else
    window="opencode"
    tmux new-session -d -s "$session" -n "tuicr" -c "$path" "${env_args[@]}"
    tmux send-keys -t "$session:tuicr" "tuicr pr $(printf '%q' "$url")" Enter
    tmux new-window -d -t "$session" -n "$window" -c "$path" "${env_args[@]}"
  fi
  tmux send-keys -t "$session:$window" "$agent_cmd" Enter

  manifest_update "$id" '.state = "launched" | .launched_at = $now | .head_sha = $sha | .tmux_window = $window' \
    --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --arg sha "$sha" --arg window "$window"

  local title author
  title=$(printf '%s' "$manifest" | jq -r '.title')
  author=$(printf '%s' "$manifest" | jq -r '.author')
  state_register_worktree "$pr" "$path" "$session" "$REVIEW_REPO" "$url" "$title" "$author"
  state_set_run "$pr" "$id"
  say "Launched review of PR #$pr in tmux session '$session'."
}

# Launch queued runs, oldest first, while fewer than the limit are running.
dispatch_runs() {
  local max="$1" running id launched=0
  acquire_lock || return 1
  running=$(count_running_runs)

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    [ "$(jq -r '.state' "$(run_dir_for "$id")/manifest.json")" = "queued" ] || continue
    if [ "$running" -ge "$max" ]; then
      break
    fi
    if launch_run "$id"; then
      running=$((running + 1))
      launched=$((launched + 1))
    fi
  done < <(
    for id in $(run_ids); do
      jq -r --arg id "$id" 'select(.state == "queued") | "\(.queue_key // .created_at) \($id)"' "$(run_dir_for "$id")/manifest.json"
    done | sort | cut -d' ' -f2
  )

  release_lock
  debug "dispatched $launched run(s); $running running (limit $max)"
}

# --- Command: open -----------------------------------------------------------

cmd_open() {
  local ref="$1" kind pr

  require_repo
  require_cmd git "brew install git"
  require_cmd tmux "brew install tmux"
  require_cmd tuicr "brew install tuicr"
  require_cmd opencode "brew install opencode"
  init_github

  kind=$(classify_ref "$ref")

  if [ "$kind" = "head" ]; then
    pr=$(resolve_head_pr) || exit 1
  else
    pr=$(resolve_pr_number "$ref") || exit 1
  fi

  local meta url title author head_ref draft
  meta=$(gh_capture gh pr view "$pr" --repo "$REVIEW_REPO" \
    --json number,title,url,author,headRefName,isDraft,state) || exit 1

  if [ "$(printf '%s' "$meta" | jq -r '.state')" != "OPEN" ]; then
    echo "Warning: PR #$pr is $(printf '%s' "$meta" | jq -r '.state')." >&2
  fi

  url=$(printf '%s' "$meta" | jq -r '.url')
  title=$(printf '%s' "$meta" | jq -r '.title')
  author=$(printf '%s' "$meta" | jq -r '.author.login // "unknown"')
  head_ref=$(printf '%s' "$meta" | jq -r '.headRefName')
  draft=$(printf '%s' "$meta" | jq -r '.isDraft')

  local path latest_run
  path=$(worktree_path_for_pr "$pr")
  latest_run=$(latest_run_for_pr "$pr")

  # Never move a worktree out from under a running agent review.
  if [ -n "$latest_run" ] && run_is_active "$(run_status "$latest_run")" && [ -d "$path" ]; then
    echo "An agent review is active in .worktrees/reviews/pr-$pr; reusing it as-is."
  else
    local status=0
    prepare_worktree "$pr" "$path" > /dev/null || status=$?
    if [ "$status" -eq 2 ] && [ -d "$path" ] && worktree_is_registered "$path"; then
      echo "Reusing the existing worktree as-is." >&2
    elif [ "$status" -ne 0 ]; then
      exit 1
    fi
  fi

  local session existing
  existing=$(find_sessions_for_worktree "$path" | head -1 || true)

  if [ -n "$existing" ]; then
    session="$existing"
    echo "Session '$session' already exists, switching."
  else
    session=$(session_name_for_pr "$pr")
    if session_exists "$session"; then
      echo "Session '$session' already exists, switching."
    else
      create_review_session "$session" "$path" "$url"
    fi
  fi

  state_register_worktree "$pr" "$path" "$session" "$REVIEW_REPO" "$url" "$title" "$author"

  local label="$REVIEW_C_DIM" off="$REVIEW_C_RESET"
  echo ""
  printf '  %sPR%s       %s#%s%s %s\n' \
    "$label" "$off" "$REVIEW_C_CYAN" "$pr" "$off" "$(sanitize_cell "$title")"
  printf '  %sAuthor%s   %s\n' "$label" "$off" "$author"
  printf '  %sHead%s     %s %s(detached, read-only review)%s\n' \
    "$label" "$off" "$head_ref" "$label" "$off"
  if [ "$draft" = "true" ]; then
    printf '  %sState%s    %sdraft%s\n' "$label" "$off" "$REVIEW_C_YELLOW" "$off"
  fi
  printf '  %sWorktree%s .worktrees/reviews/pr-%s\n' "$label" "$off" "$pr"
  printf '  %sSession%s  %s\n' "$label" "$off" "$session"
  echo ""

  attach_session "$session"
}

# --- Command: start ----------------------------------------------------------

# Resolve refs (or the next N queued PRs) into unique PR numbers, in order.
resolve_start_prs() {
  local next="$1"
  shift
  local ref kind pr seen=" "

  if [ -n "$next" ]; then
    local queue snoozes
    queue=$(queue_fetch) || return 1
    snoozes=$(state_read | jq '.snoozes | keys')
    while IFS= read -r pr; do
      [ -n "$pr" ] || continue
      local latest
      latest=$(latest_run_for_pr "$pr")
      if [ -n "$latest" ] && run_is_active "$(run_status "$latest")"; then
        continue
      fi
      printf '%s\n' "$pr"
      next=$((next - 1))
      [ "$next" -gt 0 ] || break
    done < <(printf '%s' "$queue" | jq -r --argjson snoozes "$snoozes" '
      map(select(.draft == false))
      | map(select((.number | tostring) as $n | ($snoozes | index($n)) == null))
      | .[].number
    ')
  fi

  for ref in "$@"; do
    kind=$(classify_ref "$ref")
    if [ "$kind" = "head" ]; then
      pr=$(resolve_head_pr) || return 1
    else
      pr=$(resolve_pr_number "$ref") || return 1
    fi
    case "$seen" in
      *" $pr "*) continue ;;
    esac
    seen="$seen$pr "
    printf '%s\n' "$pr"
  done
}

# Decide what to do for one PR and print a JSON record of the decision.
start_one() {
  local pr="$1" force="$2" parent_session="$3" parent_tmux="$4" seq="$5"
  local meta url head_sha latest record status

  meta=$(gh_capture gh pr view "$pr" --repo "$REVIEW_REPO" \
    --json number,title,url,author,headRefName,baseRefName,headRefOid,baseRefOid,isDraft,state) || {
    jq -cn --argjson pr "$pr" '{pr: $pr, action: "error", detail: "could not load PR metadata"}'
    return 0
  }
  url=$(printf '%s' "$meta" | jq -r '.url')
  head_sha=$(printf '%s' "$meta" | jq -r '.headRefOid')

  latest=$(latest_run_for_pr "$pr")
  if [ -n "$latest" ]; then
    record=$(run_record "$latest")
    status=$(printf '%s' "$record" | jq -r '.status')
    if run_is_active "$status"; then
      if [ "$(printf '%s' "$record" | jq -r '.head_sha')" = "$head_sha" ] || [ "$status" = queued ]; then
        printf '%s' "$record" | jq -c '. + {action: "reused"}'
      else
        printf '%s' "$record" | jq -c --arg head "$head_sha" --arg pr "$pr" \
          '. + {action: "busy_stale", current_head_sha: $head,
                detail: "an agent review of an older head is still active; run `review stop \($pr)` first"}'
      fi
      return 0
    fi
    if [ "$status" = completed ] && [ "$force" != true ] &&
      [ "$(printf '%s' "$record" | jq -r '.result.head_sha_reviewed')" = "$head_sha" ]; then
      printf '%s' "$record" | jq -c '. + {action: "already_reviewed", detail: "this head was already reviewed; pass --force to review it again"}'
      return 0
    fi
  fi

  local path
  path=$(worktree_path_for_pr "$pr")
  if [ -d "$path" ] && ! worktree_is_registered "$path"; then
    jq -cn --argjson pr "$pr" --arg url "$url" --arg path "$path" \
      '{pr: $pr, url: $url, action: "conflict", detail: "\($path) exists but is not a registered worktree; move it aside or run `git worktree prune`"}'
    return 0
  fi

  local id dir
  id=$(new_run_id "$pr")
  dir=$(run_dir_for "$id")
  mkdir -p "$dir"
  write_file_atomic "$dir/manifest.json" "$(printf '%s' "$meta" | jq \
    --arg id "$id" \
    --arg repo "$REVIEW_REPO" \
    --arg path "$path" \
    --arg session "$(session_name_for_pr "$pr")" \
    --arg parent_session "$parent_session" \
    --arg parent_tmux "$parent_tmux" \
    --arg repo_root "$REPO_ROOT" \
    --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    --arg seq "$seq" '{
      run_id: $id,
      queue_key: $seq,
      pr: .number,
      repo: $repo,
      url: .url,
      title: .title,
      author: (.author.login // "unknown"),
      draft: .isDraft,
      pr_state: .state,
      head_ref: .headRefName,
      base_ref: .baseRefName,
      head_sha: .headRefOid,
      base_sha: .baseRefOid,
      worktree: $path,
      repo_root: $repo_root,
      tmux_session: $session,
      parent_session_id: (if $parent_session == "" then null else $parent_session end),
      parent_tmux_session: (if $parent_tmux == "" then null else $parent_tmux end),
      state: "queued",
      created_at: $now
    }')"
  jq -cn --arg id "$id" '{run_id: $id, action: "created"}'
}

cmd_start() {
  local next="$1" force="$2" max="$3" parent_session="$4"
  shift 4

  require_repo
  require_cmd git "brew install git"
  require_cmd tmux "brew install tmux"
  require_cmd tuicr "brew install tuicr"
  require_cmd opencode "brew install opencode"
  init_github

  if [ -z "$next" ] && [ "$#" -eq 0 ]; then
    echo "Error: 'review start' expects one or more refs, or --next N" >&2
    exit 1
  fi

  local prs
  prs=$(resolve_start_prs "$next" "$@") || exit 1
  if [ -z "$prs" ]; then
    echo "Error: no PRs to review" >&2
    exit 1
  fi

  local parent_tmux=""
  if [ -n "${TMUX:-}" ]; then
    parent_tmux=$(tmux display-message -p '#S' 2> /dev/null || true)
  fi

  mkdir -p "$RUNS_DIR"
  acquire_lock || exit 1
  # Queue keys preserve request order across batches: launch time, then position.
  local decisions="" pr index=0 stamp
  stamp=$(date -u '+%Y%m%d%H%M%S')
  while IFS= read -r pr; do
    [ -n "$pr" ] || continue
    index=$((index + 1))
    decisions+="$(start_one "$pr" "$force" "$parent_session" "$parent_tmux" "$stamp-$(printf '%03d' "$index")")"$'\n'
  done <<< "$prs"
  dispatch_runs "$max"
  release_lock

  # Re-read created runs so the output reflects whether each launched or queued.
  local records="" line id
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "$(printf '%s' "$line" | jq -r '.action')" = created ]; then
      id=$(printf '%s' "$line" | jq -r '.run_id')
      line=$(run_record "$id" | jq -c '. + {action: (if .state == "queued" then "queued" elif .status == "failed" then "error" else "launched" end)}')
    fi
    records+="$line"$'\n'
  done <<< "$decisions"

  if [ -n "$REVIEW_JSON" ]; then
    printf '%s' "$records" | jq -s --argjson max "$max" '{max_active: $max, runs: .}'
    return 0
  fi

  printf '%s' "$records" | jq -r '
    "#\(.pr // "?")\t\(.action)\t\(.status // "-")\t\(.tmux_session // "-")\t\(.detail // .title // "")"
  ' | {
    printf 'PR\tACTION\tSTATUS\tSESSION\tDETAIL\n'
    while IFS=$'\t' read -r pr action status session detail; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$(paint cyan "$pr")" "$action" "$status" \
        "$(truncate_cell "$session" 34)" "$(truncate_cell "$(sanitize_cell "$detail")" 50)"
    done
  } | render_table
  echo ""
  echo "Your tmux client was not switched. Use 'review attach <ref>' to open a session."
}

# --- Command: dispatch -------------------------------------------------------

cmd_dispatch() {
  local max="$1"
  require_repo
  require_cmd tmux "brew install tmux"

  local queued
  queued=$(queued_run_ids)
  if [ -n "$queued" ]; then
    # The repo identity comes from the manifest, so dispatch needs no GitHub call.
    REVIEW_REPO=$(jq -r '.repo' "$(run_dir_for "$(printf '%s\n' "$queued" | head -1)")/manifest.json")
    dispatch_runs "$max"
  fi

  if [ -n "$REVIEW_JSON" ]; then
    jq -n --argjson queued "$(queued_run_ids | grep -c . || true)" \
      --argjson running "$(count_running_runs)" '{queued: $queued, running: $running}'
  fi
}

queued_run_ids() {
  local id
  for id in $(run_ids); do
    jq -r 'select(.state == "queued") | .run_id' "$(run_dir_for "$id")/manifest.json"
  done
}

# --- Command: result ---------------------------------------------------------

# A run id, or any PR ref; bare numbers resolve without touching GitHub.
resolve_run_ref() {
  local ref="$1" pr id

  case "$ref" in
    pr-*-*)
      [ -f "$(run_dir_for "$ref")/manifest.json" ] || {
        echo "Error: no review run '$ref'" >&2
        return 1
      }
      printf '%s\n' "$ref"
      return 0
      ;;
  esac

  if [ "$(classify_ref "$ref")" = pr ]; then
    pr=$(normalize_pr_number "$ref")
  else
    init_github
    pr=$(resolve_pr_number "$ref") || return 1
  fi

  id=$(latest_run_for_pr "$pr")
  if [ -z "$id" ]; then
    echo "Error: no agent review runs for PR #$pr; start one with 'review start $pr'" >&2
    return 1
  fi
  printf '%s\n' "$id"
}

cmd_result() {
  local ref="$1" full="$2"
  require_repo
  require_cmd jq "brew install jq"

  local id record report
  id=$(resolve_run_ref "$ref") || exit 1
  record=$(run_record "$id")
  report=$(printf '%s' "$record" | jq -r '.report // empty')

  if [ -n "$REVIEW_JSON" ]; then
    if [ "$full" = true ] && [ -n "$report" ] && [ -f "$report" ]; then
      printf '%s' "$record" | jq --rawfile body "$report" '. + {report_markdown: $body}'
    else
      printf '%s\n' "$record"
    fi
    return 0
  fi

  printf '%s' "$record" | jq -r '"PR #\(.pr) · \(.title)\nrun \(.run_id) · \(.status) · head \(.head_sha[0:10])\nsession \(.tmux_session)"'
  if [ -n "$report" ] && [ -f "$report" ]; then
    echo ""
    if [ "$full" = true ]; then
      cat "$report"
    else
      printf '%s' "$record" | jq -r '"verdict: \(.result.verdict)\n\(.result.summary)\nfindings: \(.result.counts | to_entries | map("\(.key)=\(.value)") | join(", "))"'
      echo ""
      echo "Full report: $report (or review result $ref --full)"
    fi
  elif [ "$(printf '%s' "$record" | jq -r '.status_detail // empty')" != "" ]; then
    printf '%s' "$record" | jq -r '"detail: \(.status_detail)"'
  fi
}

# --- Command: attach / stop --------------------------------------------------

session_for_ref() {
  local ref="$1" pr id session

  if id=$(resolve_run_ref "$ref" 2> /dev/null); then
    session=$(jq -r '.tmux_session' "$(run_dir_for "$id")/manifest.json")
    if session_exists "$session"; then
      printf '%s\n' "$session"
      return 0
    fi
  fi

  if [ "$(classify_ref "$ref")" = pr ]; then
    pr=$(normalize_pr_number "$ref")
  else
    init_github
    pr=$(resolve_pr_number "$ref") || return 1
  fi
  session=$(state_worktree_field "$pr" session)
  if session_exists "$session"; then
    printf '%s\n' "$session"
    return 0
  fi
  echo "Error: no live review session for '$ref'" >&2
  return 1
}

cmd_attach() {
  require_repo
  require_cmd tmux "brew install tmux"
  local session
  session=$(session_for_ref "$1") || exit 1
  attach_session "$session"
}

# Stop the agent, not the review: the worktree and any results stay.
# A queued run has not launched anything yet, so it only needs cancelling;
# touching tmux there could kill an interactive session for the same PR.
stop_run() {
  local id="$1" manifest session window state
  manifest=$(cat "$(run_dir_for "$id")/manifest.json")
  session=$(printf '%s' "$manifest" | jq -r '.tmux_session')
  window=$(printf '%s' "$manifest" | jq -r '.tmux_window // "opencode"')
  state=$(printf '%s' "$manifest" | jq -r '.state')

  if [ "$state" != queued ] && session_exists "$session"; then
    if [ "$window" = "review-agent" ]; then
      tmux kill-window -t "=$session:$window" 2> /dev/null || true
    else
      tmux kill-session -t "=$session" 2> /dev/null || true
    fi
  fi
  manifest_update "$id" '.state = "stopped" | .stopped_at = $now' --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
}

# Active runs, optionally for one PR, oldest first.
active_run_ids() {
  local pr="${1:-}" id
  for id in $(run_ids); do
    if [ -n "$pr" ] && [ "$(jq -r '.pr' "$(run_dir_for "$id")/manifest.json")" != "$pr" ]; then
      continue
    fi
    run_is_active "$(run_status "$id")" && printf '%s\n' "$id"
  done
}

cmd_stop() {
  local ref="$1" max="$2" all="$3"
  require_repo
  require_cmd tmux "brew install tmux"

  if [ "$all" = true ]; then
    local id pr n=0
    # Hold the lock so a concurrent dispatch cannot launch a run mid-teardown.
    acquire_lock || exit 1
    for id in $(active_run_ids); do
      pr=$(jq -r '.pr' "$(run_dir_for "$id")/manifest.json")
      stop_run "$id"
      say "Stopped agent review of PR #$pr ($id)."
      n=$((n + 1))
    done
    release_lock
    if [ "$n" -eq 0 ]; then
      say "No active agent reviews."
    else
      say "Stopped $n agent review(s). Worktrees were kept; 'review clear' removes them."
    fi
    return 0
  fi

  local id status
  id=$(resolve_run_ref "$ref") || exit 1
  status=$(run_status "$id")
  if ! run_is_active "$status"; then
    say "Run $id is already $status."
    return 0
  fi
  stop_run "$id"
  say "Stopped agent review $id."
  REVIEW_REPO=$(jq -r '.repo' "$(run_dir_for "$id")/manifest.json")
  dispatch_runs "$max" || true
}

# --- Command: log ------------------------------------------------------------

cmd_log() {
  require_repo
  init_github

  local queue count
  queue=$(queue_fetch) || exit 1
  count=$(printf '%s' "$queue" | jq 'length')

  if [ "$count" -eq 0 ]; then
    printf 'No PRs are awaiting your review in %s%s%s.\n' \
      "$REVIEW_C_BOLD" "$REVIEW_REPO" "$REVIEW_C_RESET"
    echo "Hint: set REVIEW_DEBUG=1 to see the repo and PRs the query returned."
    return 0
  fi

  local now sla_seconds snoozes
  now=$(date '+%s')
  sla_seconds=$((REVIEW_SLA_HOURS * 3600))
  snoozes=$(state_read | jq '.snoozes')

  # Snoozed PRs sort to the bottom of the stack.
  local rows
  rows=$(printf '%s' "$queue" | jq -r --argjson snoozes "$snoozes" --arg fs "$REVIEW_FS" '
    map(. + { snoozed_until: ($snoozes[(.number | tostring)].until // null) })
    | sort_by([(if .snoozed_until == null then 0 else 1 end), .requested_at])
    | .[]
    | [
        (.number | tostring),
        .author,
        ((.additions | tostring) + "/-" + (.deletions | tostring)),
        .requested_at,
        (if .draft then "draft" else "" end),
        (if .snoozed_until == null then "" else (.snoozed_until | tostring) end),
        (.title | gsub("[\\n\\r\\t]"; " "))
      ]
    | join($fs)
  ')

  {
    printf 'PR\tAUTHOR\tLOC\tAGE\tSLA\tFLAGS\tTITLE\n'
    while IFS="$REVIEW_FS" read -r number author loc requested_at draft_flag snooze_until title; do
      [ -n "$number" ] || continue

      local requested_epoch age business
      requested_epoch=$(iso_to_epoch "$requested_at") || exit 1
      age=$(format_duration $((now - requested_epoch)))
      business=$(business_seconds "$requested_epoch" "$now")

      local flag_tone=dim
      [ -n "$draft_flag" ] && flag_tone=yellow

      # A snoozed row is greyed out entirely, marker included, so the eye skips
      # it; the "snoozed til HH:MM" flag carries the state without colour.
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(paint "$(row_tone "$snooze_until" cyan)" "#$number")" \
        "$(paint "$(row_tone "$snooze_until" '')" "$(sanitize_cell "$author")")" \
        "$(paint dim "+$loc")" \
        "$(paint dim "$age")" \
        "$(paint "$(row_tone "$snooze_until" "$(sla_color "$business" "$sla_seconds")")" \
          "$(sla_cell "$business" "$sla_seconds")")" \
        "$(paint "$(row_tone "$snooze_until" "$flag_tone")" \
          "$(flags_cell "$draft_flag" "$snooze_until")")" \
        "$(paint "$(row_tone "$snooze_until" '')" \
          "$(truncate_cell "$(sanitize_cell "$title")" "$REVIEW_TITLE_WIDTH")")"
    done <<< "$rows"
  } | render_table

  printf '\n%s%s%s  SLA target: %sh of Mon-Fri time from when review was requested.\n' \
    "$REVIEW_C_BOLD" "$REVIEW_REPO" "$REVIEW_C_RESET" "$REVIEW_SLA_HOURS"
}

# --- Command: status ---------------------------------------------------------

# JSON for agents: runs (latest per PR, plus anything still active) and worktrees.
status_json() {
  local all="$1" id records="" latest_ids
  latest_ids=$(run_ids | sed -E 's/^(pr-[0-9]+)-.*/\1 &/' | awk '{latest[$1]=$2} END {for (k in latest) print latest[k]}')

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    local record status
    record=$(run_record "$id") || continue
    status=$(printf '%s' "$record" | jq -r '.status')
    if [ "$all" = true ] || run_is_active "$status" || printf '%s\n' "$latest_ids" | grep -qxF "$id"; then
      records+="$record"$'\n'
    fi
  done < <(run_ids)

  local worktrees
  worktrees=$(state_read | jq '.worktrees')
  printf '%s' "$records" | jq -s --argjson worktrees "$worktrees" --argjson max "$REVIEW_MAX_ACTIVE" '
    {
      max_active: $max,
      counts: (group_by(.status) | map({key: .[0].status, value: length}) | from_entries),
      runs: sort_by(.created_at),
      worktrees: $worktrees
    }'
}

cmd_status() {
  local all="$1"
  require_repo
  require_cmd jq "brew install jq"
  require_cmd tmux "brew install tmux"

  if [ -n "$REVIEW_JSON" ]; then
    status_json "$all"
    return 0
  fi

  local rows
  rows=$(state_worktree_rows)
  rows=$(append_unregistered_rows "$rows" "(unregistered)")

  # Queued runs have no worktree yet but still belong in the overview.
  local id pr
  for id in $(queued_run_ids); do
    pr=$(jq -r '.pr' "$(run_dir_for "$id")/manifest.json")
    if ! printf '%s\n' "$rows" | cut -d "$REVIEW_FS" -f1 | grep -qxF "$pr"; then
      rows+=$'\n'"$(jq -r --arg fs "$REVIEW_FS" '[(.pr | tostring), .worktree, .tmux_session, .repo, .url, .title, .author] | join($fs)' "$(run_dir_for "$id")/manifest.json")"
    fi
  done
  rows=$(printf '%s\n' "$rows" | grep -v '^$' || true)

  if [ -z "$rows" ]; then
    echo "No active review sessions."
    return 0
  fi

  local all_rows="$rows"

  {
    printf 'PR\tSESSION\tWORKTREE\tTMUX\tTREE\tAGENT\tTITLE\n'
    while IFS="$REVIEW_FS" read -r pr path session repo url title author; do
      [ -n "$pr" ] || continue

      local tmux_state tmux_color tree_state tree_color run_state run_color latest
      if session_exists "$session"; then
        tmux_state="live" tmux_color=green
      elif [ -z "$session" ]; then
        tmux_state="none" tmux_color=dim
      else
        tmux_state="dead" tmux_color=red
      fi

      if [ ! -d "$path" ]; then
        tree_state="missing" tree_color=red
      elif [ -n "$(git -C "$path" status --porcelain 2> /dev/null)" ]; then
        tree_state="dirty" tree_color=yellow
      else
        tree_state="clean" tree_color=green
      fi

      latest=$(latest_run_for_pr "$pr")
      run_state="-" run_color=dim
      if [ -n "$latest" ]; then
        run_state=$(run_status "$latest")
        case "$run_state" in
          completed) run_color=green ;;
          running | starting) run_color=cyan ;;
          waiting | idle | queued) run_color=yellow ;;
          failed | interrupted) run_color=red ;;
          *) run_color=dim ;;
        esac
      fi

      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(paint cyan "#$pr")" \
        "$(truncate_cell "$(sanitize_cell "$session")" 34)" \
        "$(paint dim ".worktrees/reviews/$(basename "$path")")" \
        "$(paint "$tmux_color" "$tmux_state")" \
        "$(paint "$tree_color" "$tree_state")" \
        "$(paint "$run_color" "$run_state")" \
        "$(truncate_cell "$(sanitize_cell "$title")" 40)"
    done <<< "$all_rows"
  } | render_table
}

# --- Command: snooze ---------------------------------------------------------

cmd_snooze() {
  local ref="$1"

  require_repo
  init_github

  local pr kind
  kind=$(classify_ref "$ref")

  if [ "$kind" = "head" ]; then
    pr=$(resolve_head_pr) || exit 1
  else
    pr=$(resolve_pr_number "$ref") || exit 1
  fi

  local until_epoch
  until_epoch=$(end_of_day_epoch "$(date '+%s')")
  state_snooze "$pr" "$until_epoch"

  printf 'Snoozed %s#%s%s until %s%s%s.\n' \
    "$REVIEW_C_CYAN" "$pr" "$REVIEW_C_RESET" \
    "$REVIEW_C_BOLD" "$(epoch_format "$until_epoch" '%Y-%m-%d %H:%M')" "$REVIEW_C_RESET"
  echo "It stays visible in 'review log' but 'review HEAD' will skip it."
}

# --- Command: unsnooze -------------------------------------------------------

cmd_unsnooze() {
  local ref="${1:-}" all="$2"

  require_repo
  require_cmd jq "brew install jq"

  if [ "$all" = true ]; then
    local snoozed count
    snoozed=$(state_snoozed_prs)
    count=$(printf '%s' "$snoozed" | grep -c . || true)

    if [ "$count" -eq 0 ]; then
      echo "No PRs are snoozed."
      return 0
    fi

    state_clear_snoozes
    printf 'Unsnoozed %s%d%s PR(s):' "$REVIEW_C_BOLD" "$count" "$REVIEW_C_RESET"
    local pr
    while IFS= read -r pr; do
      [ -n "$pr" ] || continue
      printf ' %s#%s%s' "$REVIEW_C_CYAN" "$pr" "$REVIEW_C_RESET"
    done <<< "$snoozed"
    echo ""
    return 0
  fi

  if [ -z "$ref" ]; then
    echo "Error: 'review unsnooze' expects a ref, or --all" >&2
    list_snoozed_hint
    return 1
  fi

  # HEAD is meaningless here: it only ever selects PRs that are not snoozed.
  if [ "$(classify_ref "$ref")" = "head" ]; then
    echo "Error: HEAD never resolves to a snoozed PR; pass an explicit ref or --all" >&2
    list_snoozed_hint
    return 1
  fi

  init_github

  local pr
  pr=$(resolve_pr_number "$ref") || exit 1

  if [ -z "$(state_snoozed_until "$pr")" ]; then
    printf '%s#%s%s is not snoozed.\n' "$REVIEW_C_CYAN" "$pr" "$REVIEW_C_RESET"
    list_snoozed_hint
    return 0
  fi

  state_unsnooze "$pr"
  printf 'Unsnoozed %s#%s%s; it is back in the %sreview HEAD%s rotation.\n' \
    "$REVIEW_C_CYAN" "$pr" "$REVIEW_C_RESET" "$REVIEW_C_BOLD" "$REVIEW_C_RESET"
}

list_snoozed_hint() {
  local snoozed
  snoozed=$(state_snoozed_prs)

  if [ -z "$snoozed" ]; then
    echo "No PRs are currently snoozed." >&2
    return 0
  fi

  printf 'Currently snoozed:' >&2
  local pr
  while IFS= read -r pr; do
    [ -n "$pr" ] || continue
    printf ' #%s' "$pr" >&2
  done <<< "$snoozed"
  echo "" >&2
}

# --- Command: clear ----------------------------------------------------------

remove_review_worktree() {
  local pr="$1" path="$2" force="$3" dry_run="$4"

  if [ ! -d "$path" ]; then
    if [ "$dry_run" = true ]; then
      echo "[dry-run] Would forget missing worktree for PR #$pr"
    else
      git worktree prune
    fi
    return 0
  fi

  if [ "$force" != true ] && [ -n "$(git -C "$path" status --porcelain 2> /dev/null)" ]; then
    echo "Skip: .worktrees/reviews/$(basename "$path") has uncommitted changes (use --force)" >&2
    return 1
  fi

  if [ "$dry_run" = true ]; then
    echo "[dry-run] Would remove worktree: $path"
    return 0
  fi

  echo "Removing worktree: .worktrees/reviews/$(basename "$path")"
  if worktree_is_registered "$path"; then
    git worktree remove --force "$path"
  else
    rm -rf "$path"
    git worktree prune
  fi

  git update-ref -d "$(review_ref_for_pr "$pr")" 2> /dev/null || true
}

cmd_clear() {
  local target="${1:-}" force="$2" dry_run="$3" stop_runs="${4:-false}"
  [ "$force" = true ] && stop_runs=true

  require_repo
  require_cmd git "brew install git"
  require_cmd tmux "brew install tmux"
  require_cmd jq "brew install jq"

  local target_pr=""
  if [ -n "$target" ]; then
    init_github
    if [ "$(classify_ref "$target")" = "branch" ]; then
      # Legacy review worktrees were checked out on a branch.
      if clear_legacy_branch "$target" "$force" "$dry_run"; then
        return 0
      fi
    fi
    target_pr=$(resolve_pr_number "$target") || exit 1
  fi

  local kill_self=false cleared=0 skipped=0 cancelled=0

  # Queued runs have no worktree yet; cancel them first so nothing launches
  # while (or after) the rest is torn down. The lock keeps dispatch out.
  acquire_lock || exit 1
  local id qpr
  for id in $(queued_run_ids); do
    qpr=$(jq -r '.pr' "$(run_dir_for "$id")/manifest.json")
    if [ -n "$target_pr" ] && [ "$qpr" != "$target_pr" ]; then
      continue
    fi
    if [ "$stop_runs" != true ]; then
      echo "Skip: PR #$qpr has a queued agent review; use --stop to cancel it" >&2
      skipped=$((skipped + 1))
    elif [ "$dry_run" = true ]; then
      echo "[dry-run] Would cancel queued agent review for PR #$qpr"
      cancelled=$((cancelled + 1))
    else
      stop_run "$id"
      echo "Cancelled queued agent review for PR #$qpr"
      cancelled=$((cancelled + 1))
    fi
  done
  release_lock

  local rows
  rows=$(state_worktree_rows)
  rows=$(append_unregistered_rows "$rows" "")

  if [ -z "$rows" ]; then
    if [ "$cancelled" -eq 0 ] && [ "$skipped" -eq 0 ]; then
      echo "No review worktrees to clear."
    fi
    return 0
  fi

  # Never delete the shell we are standing in mid-teardown.
  local self_session=""
  if [ -n "${TMUX:-}" ]; then
    self_session=$(tmux display-message -p '#S')
  fi

  while IFS="$REVIEW_FS" read -r pr path session repo url title author; do
    [ -n "$pr" ] || continue
    if [ -n "$target_pr" ] && [ "$pr" != "$target_pr" ]; then
      continue
    fi

    local sessions latest_run run_state=""
    sessions=$(find_sessions_for_worktree "$path" || true)
    if [ -n "$session" ] && session_exists "$session"; then
      sessions=$(printf '%s\n%s' "$sessions" "$session" | grep -v '^$' | sort -u)
    fi

    # An agent may be mid-review in this worktree; only --force interrupts it.
    latest_run=$(latest_run_for_pr "$pr")
    [ -n "$latest_run" ] && run_state=$(run_status "$latest_run")
    if [ -n "$run_state" ] && run_is_active "$run_state"; then
      if [ "$stop_runs" != true ]; then
        echo "Skip: PR #$pr has an active agent review ($run_state); use --stop to stop it first" >&2
        skipped=$((skipped + 1))
        continue
      fi
      if [ "$dry_run" = true ]; then
        echo "[dry-run] Would stop agent review $latest_run"
      else
        stop_run "$latest_run"
      fi
    fi

    if ! remove_review_worktree "$pr" "$path" "$force" "$dry_run"; then
      skipped=$((skipped + 1))
      continue
    fi

    local s
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      if [ "$s" = "$self_session" ]; then
        kill_self=true
        continue
      fi
      if [ "$dry_run" = true ]; then
        echo "[dry-run] Would kill tmux session: $s"
      else
        echo "Killing tmux session: $s"
        tmux kill-session -t "=$s" 2> /dev/null || true
      fi
    done <<< "$sessions"

    if [ "$dry_run" != true ]; then
      state_forget_worktree "$pr"
    fi
    cleared=$((cleared + 1))
  done <<< "$rows"

  if [ -n "$target_pr" ] && [ "$cleared" -eq 0 ] && [ "$skipped" -eq 0 ] && [ "$cancelled" -eq 0 ]; then
    echo "No review worktree found for PR #$target_pr."
    return 0
  fi

  echo ""
  if [ "$dry_run" = true ]; then
    echo "[dry-run] Would clear $cleared review worktree(s)."
  else
    echo "Cleared $cleared review worktree(s)."
  fi
  if [ "$skipped" -gt 0 ]; then
    printf '%sSkipped %d item(s): --stop stops active or queued reviews, --force also removes worktrees with local changes.%s\n' \
      "$REVIEW_C_YELLOW" "$skipped" "$REVIEW_C_RESET"
  fi
  echo "No branches were deleted. Agent review results were kept."

  if [ "$kill_self" = true ] && [ "$dry_run" != true ]; then
    kill_own_session "$self_session"
  fi
}

# Step out of the session being torn down, then kill it last.
kill_own_session() {
  local session="$1" other

  if [ "$(pwd -P)" != "$REPO_ROOT" ]; then
    cd "$REPO_ROOT" 2> /dev/null || true
  fi

  other=$(tmux list-sessions -F '#S' 2> /dev/null | grep -vxF "$session" | head -1 || true)

  if [ -z "$other" ]; then
    echo "Note: '$session' is the only tmux session; leaving it running."
    return 0
  fi

  echo "Switching to '$other' and killing '$session'..."
  tmux switch-client -t "=$other"
  tmux kill-session -t "=$session" 2> /dev/null || true
}

# Tear down a pre-PR-era review worktree that is checked out on a branch.
clear_legacy_branch() {
  local branch="$1" force="$2" dry_run="$3" wt_path="" candidate=""

  while IFS= read -r line; do
    case "$line" in
      "worktree "*) candidate="${line#worktree }" ;;
      "branch refs/heads/$branch")
        case "$candidate" in
          "$REPO_ROOT/.worktrees/"*)
            wt_path="$candidate"
            break
            ;;
        esac
        ;;
      "") candidate="" ;;
    esac
  done < <(git worktree list --porcelain)

  if [ -z "$wt_path" ]; then
    return 1
  fi

  echo "Found legacy review worktree for branch '$branch'."

  local sessions s
  sessions=$(find_sessions_for_worktree "$wt_path" || true)
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    if [ "$dry_run" = true ]; then
      echo "[dry-run] Would kill tmux session: $s"
    else
      echo "Killing tmux session: $s"
      tmux kill-session -t "=$s" 2> /dev/null || true
    fi
  done <<< "$sessions"

  if [ "$force" != true ] && [ -n "$(git -C "$wt_path" status --porcelain 2> /dev/null)" ]; then
    echo "Error: '$wt_path' has uncommitted changes (use --force)" >&2
    return 0
  fi

  if [ "$dry_run" = true ]; then
    echo "[dry-run] Would remove worktree: $wt_path"
  else
    if [ "$(pwd -P)" != "$REPO_ROOT" ]; then
      cd "$REPO_ROOT" 2> /dev/null || true
    fi
    echo "Removing worktree: $wt_path"
    git worktree remove --force "$wt_path"
  fi

  echo "Branch '$branch' was not deleted."
  return 0
}

# --- Main --------------------------------------------------------------------

main() {
  set -euo pipefail

  if [ "$REVIEW_DATE_FLAVOR" = unknown ]; then
    echo "Error: date(1) on PATH supports neither BSD (-j/-r) nor GNU (-d) syntax" >&2
    echo "  found: $(command -v date)" >&2
    exit 1
  fi

  local force=false dry_run=false all=false full=false stop_runs=false
  local next="" max="$REVIEW_MAX_ACTIVE" parent_session=""
  local args=()

  # Value-taking options accept both "--opt value" and "--opt=value".
  need_value() {
    if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
      echo "Error: $1 expects a value" >&2
      exit 1
    fi
  }

  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help)
        display_help
        ;;
      -f | --force)
        force=true
        ;;
      -n | --dry-run)
        dry_run=true
        ;;
      -a | --all)
        all=true
        ;;
      --json)
        REVIEW_JSON=1
        ;;
      --stop)
        stop_runs=true
        ;;
      --full)
        full=true
        ;;
      --next)
        need_value "$1" "${2:-}"
        next="$2"
        shift
        ;;
      --next=*) next="${1#*=}" ;;
      --max-active)
        need_value "$1" "${2:-}"
        max="$2"
        shift
        ;;
      --max-active=*) max="${1#*=}" ;;
      --parent-session)
        need_value "$1" "${2:-}"
        parent_session="$2"
        shift
        ;;
      --parent-session=*) parent_session="${1#*=}" ;;
      --)
        shift
        while [ $# -gt 0 ]; do
          args+=("$1")
          shift
        done
        break
        ;;
      -*)
        echo "Error: unknown option: $1" >&2
        exit 1
        ;;
      *)
        args+=("$1")
        ;;
    esac
    shift
  done

  case "$next" in
    '' | [1-9] | [1-9][0-9]) ;;
    *)
      echo "Error: --next expects a number from 1 to 99" >&2
      exit 1
      ;;
  esac
  case "$max" in
    [1-9] | [1-9][0-9]) ;;
    *)
      echo "Error: --max-active expects a number from 1 to 99" >&2
      exit 1
      ;;
  esac

  if [ "${#args[@]}" -eq 0 ]; then
    echo "Error: expected a ref or subcommand" >&2
    echo "Usage: review <ref>|HEAD|log|status|snooze <ref>|clear [ref]|start <ref>...|result <ref>" >&2
    exit 1
  fi

  local subcommand="${args[0]}"

  expect_one_ref() {
    [ "${#args[@]}" -eq 2 ] || {
      echo "Error: 'review $subcommand' expects exactly one ref" >&2
      exit 1
    }
  }

  case "$subcommand" in
    log)
      [ "${#args[@]}" -eq 1 ] || {
        echo "Error: 'review log' takes no arguments" >&2
        exit 1
      }
      cmd_log
      ;;
    status)
      [ "${#args[@]}" -eq 1 ] || {
        echo "Error: 'review status' takes no arguments" >&2
        exit 1
      }
      cmd_status "$all"
      ;;
    snooze)
      expect_one_ref
      cmd_snooze "${args[1]}"
      ;;
    unsnooze)
      [ "${#args[@]}" -le 2 ] || {
        echo "Error: 'review unsnooze' expects at most one ref" >&2
        exit 1
      }
      cmd_unsnooze "${args[1]:-}" "$all"
      ;;
    clear)
      [ "${#args[@]}" -le 2 ] || {
        echo "Error: 'review clear' expects at most one ref" >&2
        exit 1
      }
      cmd_clear "${args[1]:-}" "$force" "$dry_run" "$stop_runs"
      ;;
    start)
      cmd_start "$next" "$force" "$max" "$parent_session" "${args[@]:1}"
      ;;
    dispatch)
      [ "${#args[@]}" -eq 1 ] || {
        echo "Error: 'review dispatch' takes no arguments" >&2
        exit 1
      }
      cmd_dispatch "$max"
      ;;
    result)
      expect_one_ref
      cmd_result "${args[1]}" "$full"
      ;;
    attach)
      expect_one_ref
      cmd_attach "${args[1]}"
      ;;
    stop)
      if [ "$all" = true ]; then
        [ "${#args[@]}" -eq 1 ] || {
          echo "Error: 'review stop --all' takes no ref" >&2
          exit 1
        }
        cmd_stop "" "$max" true
      else
        expect_one_ref
        cmd_stop "${args[1]}" "$max" false
      fi
      ;;
    *)
      [ "${#args[@]}" -eq 1 ] || {
        echo "Error: unexpected argument: ${args[1]}" >&2
        exit 1
      }
      cmd_open "$subcommand"
      ;;
  esac
}

# Presentation is initialised even when sourced, so render_table works standalone.
setup_borders
setup_colors

if [ -z "${REVIEW_LIB_ONLY:-}" ]; then
  main "$@"
fi
