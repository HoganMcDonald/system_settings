#!/usr/bin/env bash
#
# opencode-session-state - Persist the OpenCode state for the current tmux
# session. Invoked by the OpenCode agent-state plugin.

set -e

STATUS="${1:-}"
[ -z "$STATUS" ] && exit 0

SESSION="${2:-}"
[ -n "$SESSION" ] || SESSION=$(tmux display-message -p '#S' 2>/dev/null || true)
[ -z "$SESSION" ] && exit 0
PANE="${3:-}"

CACHE_DIR="$HOME/.cache/opencode-sessions"
STATE="$CACHE_DIR/state.json"
mkdir -p "$CACHE_DIR"
[ -f "$STATE" ] || echo '{}' > "$STATE"
if ! jq empty "$STATE" 2>/dev/null; then
  echo '{}' > "$STATE"
fi

if [ "$STATUS" = "seen" ]; then
  if [ -n "$PANE" ]; then
    tmux display-message -p -t "$PANE" '#{pane_current_command}' 2>/dev/null | grep -qx 'opencode' || exit 0
  else
    tmux display-message -p '#{pane_current_command}' 2>/dev/null | grep -qx 'opencode' || exit 0
  fi

  tmp=$(mktemp "$CACHE_DIR/state.XXXXXX")
  jq --arg session "$SESSION" \
    'if .[$session].status == "waiting" then .[$session].status = "idle" else . end' \
    "$STATE" > "$tmp" && mv "$tmp" "$STATE"
elif [ "$STATUS" = "end" ]; then
  tmp=$(mktemp "$CACHE_DIR/state.XXXXXX")
  jq --arg session "$SESSION" 'del(.[$session])' "$STATE" > "$tmp" && mv "$tmp" "$STATE"
else
  case "$STATUS" in
    idle|working|waiting) ;;
    *) exit 0 ;;
  esac

  now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  tmp=$(mktemp "$CACHE_DIR/state.XXXXXX")
  jq --arg session "$SESSION" --arg status "$STATUS" --arg now "$now" \
    '.[$session] = {status: $status, updated_at: $now}' "$STATE" > "$tmp" && mv "$tmp" "$STATE"
fi

tmux refresh-client -S 2>/dev/null || true
command -v palette-sessions-regen >/dev/null && palette-sessions-regen || true
