#!/usr/bin/env bash
#
# unreview - Deprecated alias for `review clear`
#
# Usage: unreview [ref] [-f|--force] [-n|--dry-run]

set -euo pipefail

display_help() {
  cat << 'EOF'
unreview - Deprecated alias for `review clear`

Usage: unreview [options] [ref]

Options:
  -f, --force    Remove worktrees even when dirty
  -n, --dry-run  Show what would be done without doing it
  -h, --help     Display this help message and exit

Kept for muscle memory and older tmux-palette entries. With no ref it clears
every review worktree and tmux session in the current repository; with a ref it
clears just that one. Legacy branch-based review worktrees are still handled.

Use `review clear` directly going forward.
EOF
  exit 0
}

for arg in "$@"; do
  case "$arg" in
    -h | --help) display_help ;;
  esac
done

echo "Note: unreview is deprecated; use 'review clear' instead." >&2

exec review clear "$@"
