#!/usr/bin/env bash
#
# palette-sessions-regen - Regenerate ~/.config/tmux-palette/commands.json from
# tmux's current session list + cached agent state + the curated
# commands.static.json. Session entries are emitted FIRST so they appear at
# the top of the palette.
#
# Triggers:
#   - Claude Code hooks and the OpenCode agent-state plugin
#   - tmux session-created / session-closed hooks (see plugins.conf or settings)

set -e

CONFIG_DIR="$HOME/.config/tmux-palette"
STATIC="$CONFIG_DIR/commands.static.json"
OUT="$CONFIG_DIR/commands.json"
CLAUDE_STATE_FILE="$HOME/.cache/claude-sessions/state.json"
OPENCODE_STATE_FILE="$HOME/.cache/opencode-sessions/state.json"

[ -f "$STATIC" ] || { echo "missing $STATIC" >&2; exit 1; }
mkdir -p "$(dirname "$CLAUDE_STATE_FILE")" "$(dirname "$OPENCODE_STATE_FILE")"
[ -f "$CLAUDE_STATE_FILE" ] || echo '{}' > "$CLAUDE_STATE_FILE"
[ -f "$OPENCODE_STATE_FILE" ] || echo '{}' > "$OPENCODE_STATE_FILE"
if ! CLAUDE_STATE=$(jq -c . "$CLAUDE_STATE_FILE" 2>/dev/null); then
  CLAUDE_STATE='{}'
  printf '%s\n' "$CLAUDE_STATE" > "$CLAUDE_STATE_FILE"
fi
if ! OPENCODE_STATE=$(jq -c . "$OPENCODE_STATE_FILE" 2>/dev/null); then
  OPENCODE_STATE='{}'
  printf '%s\n' "$OPENCODE_STATE" > "$OPENCODE_STATE_FILE"
fi

# Build a sessions JSON array from tmux + state cache. Each entry switches
# the client to that session.
SESSIONS=$(tmux list-sessions -F '#S' 2>/dev/null || true)
CURRENT=$(tmux display-message -p '#S' 2>/dev/null || echo '')
OPENCODE_SESSIONS=$(tmux list-panes -a -F '#{session_name}|#{pane_current_command}' 2>/dev/null \
  | awk -F '|' '$2 == "opencode" { print $1 }' | sort -u)

# Native tmux session pickers cannot run shell commands in their display
# format, so cache each session's icon in a tmux user option for prefix + s.
while IFS= read -r session; do
  [ -n "$session" ] || continue

  if printf '%s\n' "$OPENCODE_SESSIONS" | grep -Fqx "$session"; then
    status=$(jq -r --arg session "$session" '.[$session].status // "idle"' <<< "$OPENCODE_STATE")
    case "$status" in
      working) icon='🌀' ;;
      waiting) icon='🔔' ;;
      *)       icon='🤖' ;;
    esac
  else
    icon=''
  fi

  tmux set-option -q -t "$session" @opencode-status "$icon"
done <<< "$SESSIONS"

SESSION_ITEMS=$(jq -n --arg current "$CURRENT" --argjson claude "$CLAUDE_STATE" \
  --argjson opencode "$OPENCODE_STATE" --rawfile sessions <(echo "$SESSIONS") \
  --rawfile opencode_sessions <(echo "$OPENCODE_SESSIONS") '
    ($sessions | rtrimstr("\n") | split("\n") | map(select(length > 0))) as $names
    | ($opencode_sessions | rtrimstr("\n") | split("\n") | map(select(length > 0))) as $opencode_active
    | $names | map(
        . as $name
        | (if $opencode_active | index($name)
           then $opencode[$name].status // "idle"
           else $claude[$name].status // "idle"
           end) as $st
        | {
            icon: (if $st == "working" then "🌀"
                   elif $st == "waiting" then "🔔"
                   elif ($opencode_active | index($name)) then "🤖"
                   else "●" end),
            iconColor: (if $st == "waiting" then "#f1ff5e"
                        elif $st == "working" then "#5ea1ff"
                        else "#5a6272" end),
            title: ($name
                     + (if $name == $current then "  (current)" else "" end)),
            description: ("session — " + $st),
            category: "Sessions",
            aliases: ["session", "s"],
            action: { tmux: ("switch-client -t " + ($name | @sh)) }
          }
      )
  ')

STATIC_ITEMS=$(cat "$STATIC")

# Live sessions first, then the static curated entries.
jq -n --argjson s "$SESSION_ITEMS" --argjson c "$STATIC_ITEMS" '$s + $c' > "$OUT.tmp"
mv "$OUT.tmp" "$OUT"
