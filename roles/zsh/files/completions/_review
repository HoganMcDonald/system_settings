#compdef review

_review() {
  local -a subcommands
  subcommands=(
    'HEAD:Open the next-up PR awaiting your review'
    'log:Show the queue of PRs awaiting your review'
    'status:Show active local review sessions'
    'snooze:Snooze a PR until end of day'
    'unsnooze:Undo a snooze'
    'clear:Tear down review worktrees and tmux sessions'
    'start:Launch agent reviews in detached sessions'
    'result:Show the latest agent review for a PR'
    'attach:Switch to a PR review session'
    'stop:Stop an active agent review'
    'dispatch:Launch queued agent reviews'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[Display help message]' \
    '(-a --all)'{-a,--all}'[Every snooze (unsnooze) or active review (stop)]' \
    '(-f --force)'{-f,--force}'[Remove worktrees even when dirty]' \
    '(-n --dry-run)'{-n,--dry-run}'[Show what would be done]' \
    '--json[Machine-readable output]' \
    '--stop[Stop active and cancel queued agent reviews first]' \
    '--full[Include the full report]' \
    '--next[Pick the next N PRs from the queue]:count:' \
    '--max-active[Concurrent running agent reviews]:count:' \
    '--parent-session[OpenCode session that requested the reviews]:session:' \
    '1: :->first' \
    '*: :->rest'

  case "$state" in
    first)
      _describe -t commands 'subcommand' subcommands
      __review_refs
      ;;
    rest)
      case "${words[2]}" in
        unsnooze)
          __review_snoozed
          ;;
        snooze | clear | start)
          __review_refs
          ;;
        result | attach | stop)
          __review_runs
          ;;
      esac
      ;;
  esac
}

# Only currently-snoozed PRs can meaningfully be unsnoozed.
__review_snoozed() {
  local state_file snoozed
  state_file="$(git rev-parse --git-common-dir 2>/dev/null)/review-state.json"
  [[ -f "$state_file" ]] || return 0

  snoozed=(${(f)"$(jq -r --argjson now "$(date +%s)" '
    .snoozes // {}
    | to_entries
    | map(select(.value.until > $now))
    | sort_by(.value.until)
    | .[].key
  ' "$state_file" 2>/dev/null)"})

  if (( ${#snoozed} )); then
    _describe -t snoozed 'snoozed PR' snoozed
  fi
}

# PRs with agent review runs, newest run last.
__review_runs() {
  local runs_dir prs
  runs_dir="$(git rev-parse --git-common-dir 2>/dev/null)/review-runs"
  [[ -d "$runs_dir" ]] || return 0
  prs=(${(f)"$(ls "$runs_dir" 2>/dev/null | sed -nE 's/^pr-([0-9]+)-.*/\1/p' | sort -un)"})
  if (( ${#prs} )); then
    _describe -t runs 'PR with agent review' prs
  fi
}

# Offer open PRs awaiting review first, then local branches.
__review_refs() {
  local -a prs branches
  prs=(${(f)"$(gh pr list --search 'review-requested:@me is:open' \
    --limit 25 --json number,title \
    -q '.[] | "\(.number):\(.title)"' 2>/dev/null)"})
  if (( ${#prs} )); then
    _describe -t pulls 'PR awaiting review' prs
  fi

  branches=(${(f)"$(git branch --format='%(refname:short)' 2>/dev/null)"})
  if (( ${#branches} )); then
    _describe -t branches 'branch' branches
  fi
}

_review "$@"
